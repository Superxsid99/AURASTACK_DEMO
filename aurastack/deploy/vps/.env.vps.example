APP_HOST=pace.claritymvp.com
API_HOST=api.claritymvp.com
WEB_ORIGIN=https://pace.claritymvp.com
LETSENCRYPT_EMAIL=you@yourdomain.com

POSTGRES_DB=smart_case_buddy
POSTGRES_USER=smart
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://smart:replace-with-strong-password@postgres:5432/smart_case_buddy?schema=public

REDIS_URL=redis://redis:6379
AGENTS_SERVICE_URL=http://agents:8001
API_INTERNAL_URL=http://api:8000
INTERNAL_WORKER_TOKEN=replace-with-random-secret
JWT_SECRET=replace-with-long-random-secret

AUTH_REQUIRED=true
INTAKE_QUEUE_ENABLED=true
WORKFLOW_QUEUE_ENABLED=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

VITE_API_URL=https://api.claritymvp.com
VITE_SOCKET_URL=https://api.claritymvp.com

# Optional same-host setup:
# VITE_API_URL=/api
# VITE_SOCKET_URL=

